<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UserProject.Views.ViewCrearUser"
             Title="ViewCrearUser">

    <ScrollView>
        <VerticalStackLayout Spacing="20">
            

            <Border BackgroundColor="#fff"
                         Stroke="#ecb300"
                         StrokeShape="RoundRectangle 12"
                         Padding="10"
                         Margin="10, 0">
                
                <VerticalStackLayout Padding="20" Spacing="20">
                    <Label Text="INFORMACIÓN BÁSICA"
                           FontAttributes="Bold"
                           FontSize="18"
                           TextColor="#00833c"/>
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Nombre:" FontAttributes="Bold" FontSize="16"/>
                        <Label Text="Esteban Reyes" FontSize="16"/>
                    </HorizontalStackLayout>
                    
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Documento:" FontAttributes="Bold" FontSize="16"/>
                        <Label Text="10584637879" FontSize="16"/>
                    </HorizontalStackLayout>
                    
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Correo" FontAttributes="Bold" FontSize="16"/>
                        <Label Text="correo@example.com" FontSize="16"/>
                    </HorizontalStackLayout>


                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Telefono:" FontAttributes="Bold" FontSize="16"/>
                        <Label Text="3127597685" FontSize="16"/>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Dirección:" FontAttributes="Bold" FontSize="16"/>
                        <Label Text="Calle 20 #04-8 Miraflorez" FontSize="16"/>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Edad:" FontAttributes="Bold" FontSize="16"/>
                        <Label Text="29 Años" FontSize="16"/>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Ciudad:" FontAttributes="Bold" FontSize="16"/>
                        <Label Text="Guadalajara" FontSize="16"/>
                    </HorizontalStackLayout>

                </VerticalStackLayout>

            </Border>

            <Border BackgroundColor="#fff"
             Stroke="#ecb300"
             StrokeShape="RoundRectangle 12"
             Padding="10"
             Margin="10, 0">
                <VerticalStackLayout Padding="20" Spacing="20">
                    <Label Text="AGREGAR FIRMA"
                           FontAttributes="Bold"
                           FontSize="18"
                           TextColor="#00833c"/>

                    <Button 
                        Text="Agregar Firma"
                        Style="{StaticResource BotonStyle}"
                        Clicked="AgregarFirma" />


                </VerticalStackLayout>

            </Border>

            <HorizontalStackLayout Spacing="20" 
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center">
                <Button 
                    Text="Volver"
                    Style="{StaticResource BotonStyle}"
                    Clicked="VolverInicio" />

                <Button 
                    Text="Guardar"
                    Style="{StaticResource BotonStyle}"
                    Clicked="GuardarCambios" />
            </HorizontalStackLayout>


        </VerticalStackLayout>
    </ScrollView>
</ContentPage>